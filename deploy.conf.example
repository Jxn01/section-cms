ftp_host = ftp.szerver.hu
ftp_port = 21
ftp_user = felhasznalonev
ftp_pass = jelszo_ide
site_url = https://www.weboldal.hu

# Távoli mappa (legtöbb hosting: / vagy /public_html/)
remote_base = /
