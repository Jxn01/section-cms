# Section CMS — environment configuration
# Copy this file to ".env" (kept out of version control) and fill it in.
# .env lives in the project root, one level above the web root.

# ─── Database (required) ───
DB_HOST=localhost
DB_NAME=section_cms
DB_USER=section_cms
DB_PASS=change-me

# ─── Canonical site URL (recommended) ───
# Used for absolute URLs (sitemap, canonical, Open Graph). If omitted,
# it is derived from the incoming request. CLI scripts should set it.
SITE_URL=https://www.example.com

# ─── First admin account (optional) ───
# Read by database/setup.php when creating the initial admin user.
# If ADMIN_PASS is left blank, setup.php generates a random password
# and shows it once.
ADMIN_USER=admin
ADMIN_PASS=

# ─── SMTP (optional — contact form email notifications) ───
# These are fallbacks; the same values can also be set in the admin
# panel under Settings. Port 465 = implicit TLS, otherwise STARTTLS.
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMTP_PORT=587
SMTP_FROM=
SMTP_TO=
